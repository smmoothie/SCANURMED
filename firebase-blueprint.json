{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "An approved pharmaceutical company linked to its Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the company account."
        },
        "applicationId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the approved company application; matches the company UID."
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "description": "Official name of the pharmaceutical company."
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "description": "Contact email for the company."
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "licenseNumber": {
          "type": "string",
          "maxLength": 100
        },
        "licenseType": {
          "type": "string",
          "maxLength": 100
        },
        "licenseDetails": {
          "type": "string",
          "maxLength": 1000
        },
        "representativeName": {
          "type": "string",
          "maxLength": 150,
          "description": "Authorized representative full name."
        },
        "status": {
          "type": "string",
          "enum": ["APPROVED", "REJECTED"]
        },
        "approvedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Timestamp when the company registered."
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid", "applicationId", "name", "email", "phone", "address",
        "licenseNumber", "licenseType", "licenseDetails", "representativeName",
        "status", "createdAt", "approvedAt", "approvedByUid"
      ]
    },
    "CompanyRegistrationRequest": {
      "title": "CompanyRegistrationRequest",
      "description": "A company application indexed by applicant Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the applicant."
        },
        "companyName": {
          "type": "string",
          "maxLength": 200,
          "description": "Legal name of the pharmaceutical company."
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "description": "Official business email."
        },
        "licenseNumber": {
          "type": "string",
          "maxLength": 100,
          "description": "Pharmaceutical manufacturing or distribution license ID."
        },
        "licenseType": {
          "type": "string",
          "maxLength": 100
        },
        "licenseDetails": {
          "type": "string",
          "maxLength": 1000
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "contactPerson": {
          "type": "string",
          "maxLength": 150,
          "description": "Primary regulatory contact name."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Business contact phone number."
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Additional verification notes."
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "APPROVED", "REJECTED"],
          "description": "Review status of the registration request."
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Submission timestamp."
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "reviewedByUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the administrator who made the decision."
        }
      },
      "required": [
        "uid", "companyName", "email", "phone", "address", "licenseNumber",
        "licenseType", "licenseDetails", "contactPerson", "notes", "status", "submittedAt"
      ]
    },
    "Medicine": {
      "title": "Medicine",
      "description": "An authorized medicine product registered on the platform.",
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference to the company that owns this medicine."
        },
        "companyName": {
          "type": "string",
          "maxLength": 200,
          "description": "Denormalized company name for quick display."
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "description": "Name of the medicine."
        },
        "ingredients": {
          "type": "array",
          "description": "List of active ingredients."
        },
        "dosage": {
          "type": "string",
          "maxLength": 1000,
          "description": "Standard dosage information."
        },
        "sideEffects": {
          "type": "string",
          "maxLength": 1000,
          "description": "Possible side effects."
        },
        "barcode": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authorized QR code value."
        },
        "qr_code": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "QR code identifier matching barcode."
        },
        "mfgDate": {
          "type": "string",
          "format": "date",
          "maxLength": 32,
          "description": "Manufacturing date."
        },
        "expiryDate": {
          "type": "string",
          "format": "date",
          "maxLength": 32,
          "description": "Expiry date."
        },
        "medicalUses": {
          "type": "string",
          "maxLength": 1000,
          "description": "Primary medical uses."
        },
        "otherUses": {
          "type": "string",
          "maxLength": 1000,
          "description": "Secondary or other possible uses."
        },
        "allergyWarnings": {
          "type": "string",
          "maxLength": 1000,
          "description": "Warnings for allergic reactions."
        },
        "alternatives": {
          "type": "array",
          "description": "List of alternative medicine names."
        },
        "scanCount": {
          "type": "integer",
          "description": "Total number of times this medicine has been scanned."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "Creation timestamp."
        }
      },
      "required": ["companyId", "companyName", "name", "barcode", "ingredients", "scanCount"]
    },
    "ScanLog": {
      "title": "ScanLog",
      "description": "A log entry for every time an authorized medicine is scanned.",
      "type": "object",
      "properties": {
        "medicineId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID of the medicine scanned."
        },
        "companyId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID of the company that owns the medicine."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "When the scan occurred."
        }
      },
      "required": ["medicineId", "companyId", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "Minimal Firebase-authenticated user profile without client-editable roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "displayName": { "type": ["string", "null"], "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "CompanyMedicineRecord": {
      "title": "CompanyMedicineRecord",
      "description": "Persistent medicine batch submission owned by an approved company.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 200 },
        "manufacturerName": { "type": "string", "maxLength": 200 },
        "licenseNumber": { "type": "string", "maxLength": 100 },
        "licenseType": { "type": "string", "maxLength": 100 },
        "licenseDetails": { "type": "string", "maxLength": 1000 },
        "name": { "type": "string", "maxLength": 200 },
        "activeComponent": { "type": "string", "maxLength": 500 },
        "batchNumber": { "type": "string", "maxLength": 100 },
        "manufacturingDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": "string", "format": "date" },
        "imagePath": { "type": "string", "maxLength": 512 },
        "registeredAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "companyId", "companyName", "manufacturerName", "licenseNumber", "licenseType",
        "licenseDetails", "name", "activeComponent", "batchNumber", "manufacturingDate",
        "expiryDate", "imagePath", "registeredAt"
      ]
    },
    "MedicineRegistrationHistory": {
      "title": "MedicineRegistrationHistory",
      "description": "Immutable event history for registered company medicines.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "maxLength": 128 },
        "medicineId": { "type": "string", "maxLength": 128 },
        "medicineName": { "type": "string", "maxLength": 200 },
        "eventType": { "type": "string", "enum": ["REGISTERED"] },
        "performedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "companyId", "medicineId", "medicineName", "eventType", "performedByUid", "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Minimal user profile; administrator privileges are assigned via trusted Firebase custom claims."
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Collection of approved pharmaceutical companies."
    },
    "/companyApplications/{uid}": {
      "schema": "CompanyRegistrationRequest",
      "description": "One company application per authenticated UID, with admin review metadata."
    },
    "/medicines/{medicineId}": {
      "schema": "Medicine",
      "description": "Centralized collection of authorized medicines."
    },
    "/scans/{scanId}": {
      "schema": "ScanLog",
      "description": "Logs of all authorized medicine scans for analytics."
    },
    "/company_medicines/{medicineId}": {
      "schema": "CompanyMedicineRecord",
      "description": "Medicine batch registrations, each associated with its approved company UID."
    },
    "/medicineRegistrationHistory/{historyId}": {
      "schema": "MedicineRegistrationHistory",
      "description": "Immutable audit entries for medicine registrations."
    }
  }
}
