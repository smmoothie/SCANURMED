rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasCompanyDashboardAccess(companyId) {
      return isOwner(companyId)
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.uid == companyId
        && get(/databases/$(database)/documents/companies/$(companyId)).data.status == 'APPROVED'
        && exists(/databases/$(database)/documents/companyApplications/$(companyId))
        && get(/databases/$(database)/documents/companyApplications/$(companyId)).data.uid == companyId
        && get(/databases/$(database)/documents/companyApplications/$(companyId)).data.status == 'APPROVED';
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.admin == true;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.email is string && data.email.size() <= 254
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 150))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCompany(data, companyId) {
      return data.keys().hasAll([
          'uid', 'applicationId', 'name', 'email', 'phone', 'address',
          'licenseNumber', 'licenseType', 'licenseDetails', 'representativeName',
          'status', 'createdAt', 'approvedAt', 'approvedByUid'
        ])
        && data.keys().hasOnly([
          'uid', 'applicationId', 'name', 'email', 'phone', 'address',
          'licenseNumber', 'licenseType', 'licenseDetails', 'representativeName',
          'status', 'createdAt', 'approvedAt', 'approvedByUid', 'updatedAt'
        ])
        && data.uid == companyId
        && data.applicationId == companyId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && data.licenseNumber is string && data.licenseNumber.size() > 0 && data.licenseNumber.size() <= 100
        && data.licenseType is string && data.licenseType.size() > 0 && data.licenseType.size() <= 100
        && data.licenseDetails is string && data.licenseDetails.size() > 0 && data.licenseDetails.size() <= 1000
        && data.representativeName is string && data.representativeName.size() > 0 && data.representativeName.size() <= 150
        && data.status in ['APPROVED', 'REJECTED']
        && data.createdAt is timestamp
        && data.approvedAt is timestamp
        && isValidId(data.approvedByUid)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidCompanyApplication(data, userId) {
      return data.keys().hasAll([
          'uid', 'companyName', 'email', 'phone', 'address', 'licenseNumber',
          'licenseType', 'licenseDetails', 'contactPerson', 'notes', 'status', 'submittedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'companyName', 'email', 'phone', 'address', 'licenseNumber',
          'licenseType', 'licenseDetails', 'contactPerson', 'notes', 'status',
          'submittedAt', 'reviewedAt', 'reviewedByUid'
        ])
        && data.uid == userId
        && data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && data.licenseNumber is string && data.licenseNumber.size() > 0 && data.licenseNumber.size() <= 100
        && data.licenseType is string && data.licenseType.size() > 0 && data.licenseType.size() <= 100
        && data.licenseDetails is string && data.licenseDetails.size() > 0 && data.licenseDetails.size() <= 1000
        && data.contactPerson is string && data.contactPerson.size() > 0 && data.contactPerson.size() <= 150
        && data.notes is string && data.notes.size() <= 1000
        && data.status in ['PENDING', 'APPROVED', 'REJECTED']
        && data.submittedAt is timestamp
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && (!('reviewedByUid' in data) || isValidId(data.reviewedByUid));
    }

    function isValidMedicineRegistrationHistory(data, historyId) {
      return data.keys().hasAll([
          'companyId', 'medicineId', 'medicineName', 'eventType', 'performedByUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'medicineId', 'medicineName', 'eventType', 'performedByUid', 'createdAt'
        ])
        && isValidId(historyId)
        && isValidId(data.companyId)
        && isValidId(data.medicineId)
        && data.medicineName is string && data.medicineName.size() > 0 && data.medicineName.size() <= 200
        && data.eventType == 'REGISTERED'
        && data.performedByUid == data.companyId
        && data.createdAt is timestamp;
    }

    function isValidCompanyMedicine(data, companyId) {
      return data.keys().hasAll([
          'companyId', 'companyName', 'manufacturerName', 'licenseNumber',
          'licenseType', 'licenseDetails', 'name', 'activeComponent', 'batchNumber',
          'manufacturingDate', 'expiryDate', 'imagePath', 'registeredAt'
        ])
        && data.keys().hasOnly([
          'companyId', 'companyName', 'manufacturerName', 'licenseNumber',
          'licenseType', 'licenseDetails', 'name', 'activeComponent', 'batchNumber',
          'manufacturingDate', 'expiryDate', 'imagePath', 'registeredAt'
        ])
        && data.companyId == companyId
        && data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 200
        && data.manufacturerName is string && data.manufacturerName.size() > 0 && data.manufacturerName.size() <= 200
        && data.licenseNumber is string && data.licenseNumber.size() > 0 && data.licenseNumber.size() <= 100
        && data.licenseType is string && data.licenseType.size() > 0 && data.licenseType.size() <= 100
        && data.licenseDetails is string && data.licenseDetails.size() > 0 && data.licenseDetails.size() <= 1000
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.activeComponent is string && data.activeComponent.size() > 0 && data.activeComponent.size() <= 500
        && data.batchNumber is string && data.batchNumber.size() > 0 && data.batchNumber.size() <= 100
        && data.manufacturingDate is string && data.manufacturingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.expiryDate is string && data.expiryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.imagePath is string && data.imagePath.size() > 0 && data.imagePath.size() <= 512
        && data.registeredAt is timestamp;
    }

    function matchesCompanyMedicineDetails(data, companyId) {
      let company = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return data.companyName == company.name
        && data.manufacturerName == company.name
        && data.licenseNumber == company.licenseNumber
        && data.licenseType == company.licenseType
        && data.licenseDetails == company.licenseDetails;
    }

    function isValidMedicine(data) {
      return data.keys().hasAll(['companyId', 'companyName', 'name', 'barcode', 'ingredients', 'scanCount'])
        && data.keys().hasOnly([
          'companyId', 'companyName', 'name', 'barcode', 'qr_code',
          'ingredients', 'dosage', 'sideEffects', 'mfgDate', 'expiryDate',
          'medicalUses', 'otherUses', 'allergyWarnings', 'alternatives',
          'scanCount', 'createdAt'
        ])
        && isValidId(data.companyId)
        && data.companyName is string && data.companyName.size() > 0 && data.companyName.size() <= 200
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.barcode is string && data.barcode.size() > 0 && data.barcode.size() <= 64 && data.barcode.matches('^[a-zA-Z0-9_\\-]+$')
        && (!('qr_code' in data) || (data.qr_code is string && data.qr_code.size() > 0 && data.qr_code.size() <= 64 && data.qr_code.matches('^[a-zA-Z0-9_\\-]+$')))
        && data.ingredients is list && data.ingredients.size() >= 1 && data.ingredients.size() <= 30 && data.ingredients[0] is string
        && (!('dosage' in data) || (data.dosage is string && data.dosage.size() <= 1000))
        && (!('sideEffects' in data) || (data.sideEffects is string && data.sideEffects.size() <= 1000))
        && (!('mfgDate' in data) || (data.mfgDate is string && data.mfgDate.size() <= 32))
        && (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 32))
        && (!('medicalUses' in data) || (data.medicalUses is string && data.medicalUses.size() <= 1000))
        && (!('otherUses' in data) || (data.otherUses is string && data.otherUses.size() <= 1000))
        && (!('allergyWarnings' in data) || (data.allergyWarnings is string && data.allergyWarnings.size() <= 1000))
        && (!('alternatives' in data) || (data.alternatives is list && data.alternatives.size() <= 20 && (data.alternatives.size() == 0 || data.alternatives[0] is string)))
        && data.scanCount is int && data.scanCount >= 0
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidScanLog(data) {
      return data.keys().hasAll(['medicineId', 'companyId', 'timestamp'])
        && data.keys().hasOnly(['medicineId', 'companyId', 'timestamp'])
        && isValidId(data.medicineId)
        && isValidId(data.companyId)
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64;
    }

    function isValidCustomerProfile(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'phoneVerified', 'createdAt'])
        && data.uid == userId
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 150
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && (!('phone' in data) || (data.phone is string && data.phone.matches('^\\+[1-9][0-9]{7,14}$')))
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && (!(('phoneVerified' in data) && data.phoneVerified == true)
          || (('phone' in data) && request.auth.token.phone_number == data.phone));
    }

    function isValidCustomerScan(data, userId) {
      return data.keys().hasAll([
          'uid', 'medicineId', 'companyId', 'barcode', 'medicineName', 'scannedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'medicineId', 'companyId', 'barcode', 'medicineName', 'companyName',
          'ingredients', 'dosage', 'sideEffects', 'mfgDate', 'expiryDate',
          'medicalUses', 'otherUses', 'allergyWarnings', 'alternatives', 'qrCode',
          'scannedAt'
        ])
        && data.uid == userId
        && isValidId(data.medicineId)
        && isValidId(data.companyId)
        && data.barcode is string && data.barcode.size() > 0 && data.barcode.size() <= 128
        && data.medicineName is string && data.medicineName.size() > 0 && data.medicineName.size() <= 200
        && data.scannedAt is string && data.scannedAt.size() > 0 && data.scannedAt.size() <= 64
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 200))
        && (!('ingredients' in data) || (data.ingredients is list && data.ingredients.size() <= 30))
        && (!('dosage' in data) || (data.dosage is string && data.dosage.size() <= 1000))
        && (!('sideEffects' in data) || (data.sideEffects is string && data.sideEffects.size() <= 1000))
        && (!('mfgDate' in data) || (data.mfgDate is string && data.mfgDate.size() <= 32))
        && (!('expiryDate' in data) || (data.expiryDate is string && data.expiryDate.size() <= 32))
        && (!('medicalUses' in data) || (data.medicalUses is string && data.medicalUses.size() <= 1000))
        && (!('otherUses' in data) || (data.otherUses is string && data.otherUses.size() <= 1000))
        && (!('allergyWarnings' in data) || (data.allergyWarnings is string && data.allergyWarnings.size() <= 1000))
        && (!('alternatives' in data) || (data.alternatives is list && data.alternatives.size() <= 20))
        && (!('qrCode' in data) || (data.qrCode is string && data.qrCode.size() <= 128));
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.name.matches('.*\\S.*')
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && (!('phone' in data) || (
          data.phone is string
          && data.phone.size() >= 10
          && data.phone.size() <= 13
          && data.phone.matches('^\\+?[0-9]{10,13}$')
        ))
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200
        && data.subject.matches('.*\\S.*')
        && data.message is string && data.message.size() > 0 && data.message.size() <= 5000
        && data.message.matches('.*\\S.*')
        && data.createdAt == request.time;
    }

    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow get, list: if isAdmin() && isValidId(messageId);
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'displayName', 'updatedAt'
        ])
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow get: if isValidId(companyId) && (isOwner(companyId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(companyId)
        && isValidCompany(incoming(), companyId)
        && incoming().status == 'APPROVED'
        && getAfter(/databases/$(database)/documents/companyApplications/$(companyId)).data.status == 'APPROVED'
        && getAfter(/databases/$(database)/documents/companyApplications/$(companyId)).data.uid == companyId;
      allow update: if (isAdmin()
        && isValidId(companyId)
        && isValidCompany(incoming(), companyId))
        || (isOwner(companyId)
        && hasCompanyDashboardAccess(companyId)
        && isValidId(companyId)
        && isValidCompany(incoming(), companyId)
        && existing().status == 'APPROVED'
        && incoming().status == existing().status
        && incoming().applicationId == existing().applicationId
        && incoming().createdAt == existing().createdAt
        && incoming().approvedAt == existing().approvedAt
        && incoming().approvedByUid == existing().approvedByUid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'email', 'representativeName', 'updatedAt'
        ]));
      allow delete: if isAdmin() && isValidId(companyId);
    }

    match /companyApplications/{applicationId} {
      allow get: if isValidId(applicationId) && (isOwner(applicationId) || isAdmin());
      allow list: if isAdmin()
        || isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(applicationId)
        && isOwner(applicationId)
        && isValidCompanyApplication(incoming(), applicationId)
        && incoming().status == 'PENDING'
        && incoming().submittedAt == request.time
        && !('reviewedAt' in incoming())
        && !('reviewedByUid' in incoming());
      allow update: if isAdmin()
        && isValidId(applicationId)
        && isValidCompanyApplication(incoming(), applicationId)
        && incoming().uid == existing().uid
        && incoming().submittedAt == existing().submittedAt
        && incoming().status in ['APPROVED', 'REJECTED']
        && incoming().reviewedAt == request.time
        && incoming().reviewedByUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedByUid'
        ]);
      allow delete: if false;
    }

    match /medicines/{medicineId} {
      allow get: if isValidId(medicineId);
      allow list: if true;
      allow create: if isValidMedicine(incoming())
        && isValidId(medicineId)
        && (isAdmin() || (
          incoming().companyId == request.auth.uid
          && hasCompanyDashboardAccess(incoming().companyId)
        ));
      allow update: if isValidId(medicineId) && isValidMedicine(incoming()) && (
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['scanCount'])
          && incoming().scanCount == existing().scanCount + 1
        ) || (
          incoming().companyId == existing().companyId
          && (isAdmin() || (
            existing().companyId == request.auth.uid
            && hasCompanyDashboardAccess(existing().companyId)
          ))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'ingredients', 'dosage', 'sideEffects', 'barcode', 'qr_code',
            'mfgDate', 'expiryDate', 'medicalUses', 'otherUses', 'allergyWarnings',
            'alternatives', 'companyName'
          ])
        )
      );
      allow delete: if isValidId(medicineId)
        && (isAdmin() || (
          existing().companyId == request.auth.uid
          && hasCompanyDashboardAccess(existing().companyId)
        ));
    }

    match /company_medicines/{medicineId} {
      allow get, list: if hasCompanyDashboardAccess(resource.data.companyId);
      allow create: if hasCompanyDashboardAccess(incoming().companyId)
        && isValidId(medicineId)
        && isValidCompanyMedicine(incoming(), request.auth.uid)
        && matchesCompanyMedicineDetails(incoming(), request.auth.uid)
        && incoming().imagePath == 'company-medicine-photos/' + request.auth.uid + '/' + medicineId + '/photo'
        && incoming().registeredAt == request.time;
      allow update, delete: if false;
    }

    match /medicineRegistrationHistory/{historyId} {
      allow get, list: if isAdmin()
        || isSignedIn() && resource.data.companyId == request.auth.uid
          && hasCompanyDashboardAccess(resource.data.companyId);
      allow create: if hasCompanyDashboardAccess(incoming().companyId)
        && isValidMedicineRegistrationHistory(incoming(), historyId)
        && incoming().performedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/company_medicines/$(incoming().medicineId))
        && getAfter(/databases/$(database)/documents/company_medicines/$(incoming().medicineId)).data.companyId == request.auth.uid;
      allow update, delete: if false;
    }

    match /scans/{scanId} {
      allow get: if isSignedIn() && isValidId(scanId) && (existing().companyId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.companyId == request.auth.uid || isAdmin());
      allow create: if isValidId(scanId)
        && isValidScanLog(incoming())
        && exists(/databases/$(database)/documents/medicines/$(incoming().medicineId));
      allow update, delete: if false;
    }

    // ── Customer profiles ──────────────────────────────────────────
    match /customerProfiles/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidCustomerProfile(incoming(), userId)
        && (!('phoneVerified' in incoming()) || incoming().phoneVerified == false);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isValidCustomerProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;

      // ── Customer scans sub-collection ──────────────────────────
      match /scans/{scanId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidCustomerScan(incoming(), userId);
        allow update, delete: if false;
      }
    }
  }
}
